pdxmesh = {
	name = "world_trade_center_mesh"
	file = "world_trade_center.mesh"

	meshsettings = {
		name = "3d-model"
		index = 0
		texture_diffuse = "wtc_diffuse.dds"
		texture_normal = "wtc_diffuse_normal.dds"
		texture_specular = "wtc_properties.dds"
		texture = { file = "modern_building_gradient.dds" index = 5 }
		shader = "standard"
		additional_shader_defines = { "PDX_MESH_SNAP_VERTICES_TO_TERRAIN" "TINT_COLOR" "EMISSIVE_NIGHT" }
		shader_file = "gfx/FX/pdxmesh.shader"
	}

	meshsettings = {
		name = "3d-model_local_decal"
		index = 0
		texture_diffuse = "decal_urban_residential_01_diffuse.dds"
		texture_normal = "decal_urban_residential_01_normal.dds"
		texture_specular = "decal_urban_residential_01_properties.dds"
		shader = "decal_local"
		shader_file = "gfx/FX/pdxmesh_decal.shader"
		subpass = "LocalDecals"
	}
}

entity = {
    name = "world_trade_center_entity"
    pdxmesh = "world_trade_center_mesh"
	locator = { name = "loc_light" position = { 0 0.87 -0.6 } rotation = { 0 0 0 }}

    scale = 2
}
