pdxmesh = {
	name = "airport_mesh"
	file = "airport.mesh"

	scale = 2

	meshsettings = {
		name = "airport.001"
		index = 0
		texture_diffuse = "airport_diffuse.dds"
		texture_normal = "airport_diffuse_normal.dds"
		texture_specular = "properties.dds"
		texture = { file = "modern_building_gradient.dds" index = 5 }
		shader = "standard"
		additional_shader_defines = { "PDX_MESH_SNAP_VERTICES_TO_TERRAIN" "TINT_COLOR" "SOL_VISUALS" "HUB_BUILDING" }
		shader_file = "gfx/FX/pdxmesh.shader"
	}

	meshsettings = {
		name = "airport.001_local_decal"
		index = 0
		texture_diffuse = "decal_urban_residential_01_diffuse.dds"
		texture_normal = "decal_urban_residential_01_normal.dds"
		texture_specular = "decal_urban_residential_01_properties.dds"
		shader = "decal_local"
		shader_file = "gfx/FX/pdxmesh_decal.shader"
		subpass = "LocalDecals"
	}
}

entity = {
	name = "airport_entity"
	pdxmesh = "airport_mesh"
}

pdxmesh = {
	name = "modern_professional_service_mesh"
