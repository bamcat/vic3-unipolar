pdxmesh = {
	name = "smd_apt_slab_mesh"
	file = "smd_apt_slab.mesh"

	scale = 2

	meshsettings = {
		name = "apt_slab_walls"
		index = 0
		texture_diffuse = "smd_facade_03_diffuse.dds"
		texture_normal = "smd_facade_03_normal.dds"
		texture_specular = "smd_building_properties.dds"
		texture = { file = "modern_building_gradient.dds" index = 5 }
