pdxmesh = {
	name = "mid_modern_01_mesh"
	file = "mid_modern_01.mesh"

	scale = 2

	meshsettings = {
		name = "mid_modern_01.002"
		index = 0
		texture_diffuse = "mid_modern_01_diffuse.dds"
		texture_normal = "mid_modern_01_diffuse_normal.dds"
		texture_specular = "properties.dds"
		texture = { file = "modern_building_gradient.dds" index = 5 }
		shader = "standard"
		additional_shader_defines = { "PDX_MESH_SNAP_VERTICES_TO_TERRAIN" "TINT_COLOR" "EMISSIVE_NIGHT" "EMISSIVE_NIGHT_RANDOM" "SOL_VISUALS" "HUB_BUILDING" }
		shader_file = "gfx/FX/pdxmesh.shader"
	}

	meshsettings = {
		name = "mid_modern_01.002_local_decal"
		index = 0
		texture_diffuse = "decal_urban_residential_01_diffuse.dds"
		texture_normal = "decal_urban_residential_01_normal.dds"
		texture_specular = "decal_urban_residential_01_properties.dds"
		shader = "decal_local"
		shader_file = "gfx/FX/pdxmesh_decal.shader"
		subpass = "LocalDecals"
	}
}

entity = {
	name = "mid_modern_01_entity"
	pdxmesh = "mid_modern_01_mesh"
}

