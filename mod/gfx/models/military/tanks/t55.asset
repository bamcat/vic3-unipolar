pdxmesh = {
	name = "t55_mesh"
	file = "t55.mesh"

	lod_percentages = {
		lod = { index = 1 percent = 8.0 }
	}

	meshsettings = {
		name = "bodyShape-001"
		index = 0
		texture_diffuse = "t55_diffuse.dds"
		texture_normal = "t55_normal.dds"
		texture_specular = "t55_properties.dds"
		texture = { file = "t55_masks.dds" index = 6 }
		shader = "standard"
		shader_file = "gfx/FX/pdxmesh.shader"
		additional_shader_defines = { "UNIT_COLOR" }
	}

	animation = { id = "tank_idle_animation" 					type = "t55_idle.anim" }
	animation = { id = "tank_scout_animation" 					type = "t55_scout.anim" }
	animation = { id = "tank_fire_aggressive_animation" 			type = "t55_fire_aggressive.anim" }
	animation = { id = "tank_fire_defensive_animation" 			type = "t55_fire_defensive.anim" }
	animation = { id = "tank_defeat_animation" 					type = "t55_defeat.anim" }

}

entity = {
	name = "t55_entity"
	pdxmesh = "t55_mesh"
	scale = 2

	get_state_from_parent = yes
	default_state = "walk"

	state = { name = "idle"
		animation = "tank_idle_animation"
		looping = yes
	}

	state = { name = "walk"
		animation = "tank_scout_animation"
		looping = yes
	}

	state = { name = "victory"
		time_offset = { 0.0 10.0 }
		animation = "tank_idle_animation"
		looping = yes
	}

	state = { name = "defeat"
		animation = "tank_defeat_animation"
		looping = no
	}

	state = { name = "defend"
		time_offset = { 0.0 10.0 }
		animation = "tank_fire_defensive_animation"
		looping = yes
	}

	state = { name = "advance"
		time_offset = { 0.0 10.0 }
		animation = "tank_fire_aggressive_animation"
		looping = yes
	}
}
