pdxmesh = {
	name = "pickup_90s_black_mesh"
	file = "pickup_90s.mesh"

	animation = { id = "idle_animation" type = "pickup_90s_idle.anim" }
	animation = { id = "moving_animation" type = "pickup_90s_moving.anim" }

	meshsettings = {
		name = "pickup_90sShape"
		index = 0
		texture_diffuse = "pickup_90s_black_diffuse.dds"
		texture_normal = "pickup_90s_normal.dds"
		texture_specular = "pickup_90s_properties.dds"
		shader = "standard"
		additional_shader_defines = { "EMISSIVE_NIGHT" }
		shader_file = "gfx/FX/pdxmesh.shader"
	}
}

entity = {
	name = "pickup_90s_black_entity"
	pdxmesh = "pickup_90s_black_mesh"

	default_state = "moving"

	state = {
		name = "idle"
		animation = "idle_animation"
		looping = no

		start_event = { sound = { soundeffect = "event:/SFX/Vehicles/car" } keep_sound = yes }

		next_state = "idle"
	}

	state = {
		name = "moving"
		animation = "moving_animation"
		looping = yes

		start_event = { sound = { soundeffect = "event:/SFX/Vehicles/car" } keep_sound = yes }

		event = { time = 0 node = "locator_wheel_back_02" particle = "vehicles/european_car_effects" trigger_once = yes }
	}

	scale = 0.48
}
