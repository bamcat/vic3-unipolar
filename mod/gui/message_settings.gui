									news_toggle_row = {
										blockoverride "news_label" { text = "NEWS_SETTING_WORLD_4" }
										blockoverride "news_toggle" {
											onclick = "[GetScriptedGui('news_toggle_world_4').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
