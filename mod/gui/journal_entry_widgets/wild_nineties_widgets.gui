flowcontainer = {
	name = "widget_je_wild_nineties_kremlin"
	ignoreinvisible = yes
	margin_bottom = 1

	widget = {
		size = { 510 270 }

		background = {
			texture = "gfx/interface/illustrations/journal/game_obj_illu_economic_dominance.dds"
			using = top_illu_properties
			margin = { 25 0 }
			alpha = 0.3
		}

		widget = {
			position = { 30 40 }
			size = { 145 174 }

			character_portrait_medium_torso_tsarpoint = {
				datacontext = "[AccessPlayer.GetHighestProminenceCharacterOfRole('character_role_rus_family')]"
				visible = "[And( Character.IsValid, Not(Character.IsHistorical) )]"
				parentanchor = center
				scale = 0.9
			}

			character_portrait_medium_torso_tsarpoint_historical_info_link = {
				datacontext = "[AccessPlayer.GetHighestProminenceCharacterOfRole('character_role_rus_family')]"
				visible = "[And3( Character.IsValid, Character.IsHistorical, Not(StringIsEmpty(Character.GetHistoricalUrl)) )]"
				parentanchor = center
				scale = 0.9
			}

			character_portrait_medium_torso_tsarpoint_historical_no_info_link = {
				datacontext = "[AccessPlayer.GetHighestProminenceCharacterOfRole('character_role_rus_family')]"
				visible = "[And3( Character.IsValid, Character.IsHistorical, StringIsEmpty(Character.GetHistoricalUrl) )]"
				parentanchor = center
				scale = 0.9
			}
		}

		textbox = {
			position = { 30 218 }
			size = { 145 40 }
			align = center|nobaseline
			default_format = "#title"
			text = "RUS_WN_KREMLIN_FAMILY"
		}

		widget = {
			position = { 182 40 }
			size = { 145 174 }

			character_portrait_medium_torso_tsarpoint = {
				datacontext = "[AccessPlayer.AccessRuler]"
				visible = "[And( Character.IsValid, Not(Character.IsHistorical) )]"
				parentanchor = center
				scale = 0.9
			}

			character_portrait_medium_torso_tsarpoint_historical_info_link = {
				datacontext = "[AccessPlayer.AccessRuler]"
				visible = "[And3( Character.IsValid, Character.IsHistorical, Not(StringIsEmpty(Character.GetHistoricalUrl)) )]"
				parentanchor = center
				scale = 0.9
			}

			character_portrait_medium_torso_tsarpoint_historical_no_info_link = {
				datacontext = "[AccessPlayer.AccessRuler]"
				visible = "[And3( Character.IsValid, Character.IsHistorical, StringIsEmpty(Character.GetHistoricalUrl) )]"
				parentanchor = center
				scale = 0.9
			}
		}

		textbox = {
			position = { 182 218 }
			size = { 145 40 }
			align = center|nobaseline
			default_format = "#title"
			text = "RUS_WN_KREMLIN_PRESIDENT"
		}

		widget = {
			position = { 335 40 }
			size = { 145 174 }

			character_portrait_medium_torso_tsarpoint = {
				datacontext = "[AccessPlayer.GetHighestProminenceCharacterOfRole('character_role_prime_minister')]"
				visible = "[And( Character.IsValid, Not(Character.IsHistorical) )]"
				parentanchor = center
				scale = 0.9
			}

			character_portrait_medium_torso_tsarpoint_historical_info_link = {
				datacontext = "[AccessPlayer.GetHighestProminenceCharacterOfRole('character_role_prime_minister')]"
				visible = "[And3( Character.IsValid, Character.IsHistorical, Not(StringIsEmpty(Character.GetHistoricalUrl)) )]"
				parentanchor = center
				scale = 0.9
			}

			character_portrait_medium_torso_tsarpoint_historical_no_info_link = {
				datacontext = "[AccessPlayer.GetHighestProminenceCharacterOfRole('character_role_prime_minister')]"
				visible = "[And3( Character.IsValid, Character.IsHistorical, StringIsEmpty(Character.GetHistoricalUrl) )]"
				parentanchor = center
				scale = 0.9
			}
		}

		textbox = {
			position = { 335 218 }
			size = { 145 40 }
			align = center|nobaseline
			default_format = "#title"
			text = "RUS_WN_KREMLIN_PM"
		}
	}
