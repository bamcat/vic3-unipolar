types objective_types
{
    type objective_selection_menu = widget {
        size = { 100% 100% }

        ### HEADER
        icon = {
            texture = "gfx/interface/new_game_panel/frame_start_menu_top.dds"
            size = { 560 56 }
            parentanchor = hcenter
            position = { 0 26 }
            spriteType = Corneredtiled
            spriteborder = { 100 0 }
            texture_density = 2

            textbox = {
                using = header_font_fancy
                using = header_font_fancy_size
                align = center|nobaseline
                text = "UNI_NS_TITLE"
                size = { 100% 100% }
                elide = right
                fontsize_min = 14
                margin = { 75 0 }
                margin_bottom = 5
            }
        }

        ### BACK BUTTON
        button_standard_back = {
            position = { 1% 94% }
            size = { 300 55 }
            name = "back_button"
            shortcut = "close_window"
            using = fontsize_large
            onclick = "[GameSetup.OnBack]"
            oversound = "event:/SFX/UI/Global/pointer_over"
            clicksound = "event:/SFX/UI/Global/close"
        }

        ### BOTTOM BAR
        container = {
            position = { 25% 92% }
            name = "bottom_panel_not_selected"
            layoutpolicy_horizontal = expanding
            margin = { 15 0 }
            using = default_fade_in_out

            widget = {
                layoutpolicy_horizontal = expanding
                layoutpolicy_vertical = expanding
            }

            game_rules_hbox = {}

            widget = {
                layoutpolicy_horizontal = expanding
                layoutpolicy_vertical = expanding
            }

            start_game_buttons = {}
        }



        ### NATION BRIEFINGS
        widget = {
            position = { 15% 13% }
            size = { 1290 720 }

            scrollbox = {
                layoutpolicy_vertical = expanding
                layoutpolicy_horizontal = expanding
				size = { 1290 720 }
                blockoverride "scrollbox_content" {

                    vbox = {
                        spacing = 12
                        margin_top = 26

                        hbox = {
                            spacing = 12

                            ### USA
                            widget = {
                                size = { 400 236 }

                                background = {
                                    using = default_background
                                }

                                icon = {
                                    position = { 14 14 }
                                    size = { 120 80 }
                                    texture = "gfx/interface/nation_select/flag_usa.dds"

                                    background = {
                                        using = simple_frame
                                        margin = { 3 3 }
                                    }
                                }

                                textbox = {
                                    position = { 148 16 }
                                    using = header_font_fancy
                                    using = header_font_fancy_size
                                    text = "UNI_NS_USA_NAME"
                                    size = { 238 38 }
                                    align = nobaseline
                                    elide = right
                                    fontsize_min = 14
                                }

                                textbox = {
                                    position = { 148 52 }
                                    text = "UNI_NS_USA_TAGLINE"
                                    default_format = "#I"
                                    maximumsize = { 238 42 }
                                    fontsize_min = 10
                                    autoresize = yes
                                    multiline = yes
                                    using = fontsize_medium
                                }

                                textbox = {
                                    position = { 16 104 }
                                    text = "UNI_NS_USA_BODY"
                                    default_format = "#variable"
                                    maximumsize = { 368 76 }
                                    fontsize_min = 10
                                    autoresize = yes
                                    multiline = yes
                                    using = fontsize_medium

                                    divider_decorative = {
                                        size = { 100% 1 }
                                        parentanchor = bottom
                                    }
                                }

                                textbox = {
                                    position = { 16 190 }
                                    text = "UNI_NS_USA_STATS"
                                    default_format = "#instruction"
                                    maximumsize = { 368 36 }
                                    fontsize_min = 9
                                    autoresize = yes
                                    multiline = yes
                                    using = fontsize_medium
                                }
                            
                                ### SELECTION (cosmetic only)
                                button = {
                                    size = { 100% 100% }
                                    name = "uni_select_button"
                                    visible = "[Not( GetVariableSystem.HasValue('uni_nation', 'USA') )]"
                                    oversound = "event:/SFX/UI/Global/pointer_over"
                                    clicksound = "event:/SFX/UI/Global/select"
                                    onclick = "[GetVariableSystem.Set('uni_nation', 'USA')]"
