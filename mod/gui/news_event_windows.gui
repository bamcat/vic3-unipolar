
types news_event_window_types {
	type news_event_window = widget {
		name = "news_event_window"                       # widget chain: direct property
		datacontext = "[EventWindow.GetEvent]"
		size = { 100% 100% }

		### The draggable window. `movable` and the popups layer are what the
		### popup parent used to supply.
		window = {
			parentanchor = center

			scale = "[ScaleToFitElementInside('(int32)1920', '(int32)1080')]"

			movable = yes
			layer = popups
			allow_outside = yes
			size = { 606 683 }
			alpha = 0

			### THE PAGE
			icon = {
				texture = "gfx/interface/newspaper/newspaper_bg.dds"
				size = { 100% 100% }
				alwaystransparent = yes
			}

			### MASTHEAD — one static texture per country, gated on
			### news_masthead_id (Vic3 cannot build a texture path from
			### a variable, so they are stacked and switched by id).
			icon = {
				parentanchor = hcenter
				position = { 0 24 }
				size = { 520 76 }
				texture = "gfx/interface/newspaper_headers/neutrality_header.dds"
				alwaystransparent = yes
				visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('news_masthead_id').GetValue, '(CFixedPoint)0' )]"
			}
			icon = {
				parentanchor = hcenter
				position = { 0 24 }
				size = { 520 76 }
				texture = "gfx/interface/newspaper_headers/communism_header.dds"
				alwaystransparent = yes
				visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('news_masthead_id').GetValue, '(CFixedPoint)1000' )]"
			}
			icon = {
				parentanchor = hcenter
				position = { 0 24 }
				size = { 520 76 }
				texture = "gfx/interface/newspaper_headers/fascism_header.dds"
				alwaystransparent = yes
				visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('news_masthead_id').GetValue, '(CFixedPoint)2000' )]"
			}
			# GBR
