			}

			### ENGRAVING — the ruled box on the left of the page.
			### NOTE: Vic3 has no clipping, so a landscape event video stretches
			### into this portrait box. Portrait art is the proper fix.
			icon = {
				visible = "[Event.HasTexture]"
				texture = "[Event.GetTexture]"
				position = { 38 150 }
				size = { 196 500 }
				alwaystransparent = yes
			}
			video_icon = {
				visible = "[Event.HasVideo]"
				video = "[Event.GetVideo]"
				position = { 32 202 }
				size = { 230 440 }
				alwaystransparent = yes
				loop = no
			}

			### DATELINE — issue number, live game date, price. Each slot shows a
			### default unless the event defines .sub_left / .sub_middle /
			### .sub_right. The existence test is CMF's: if Localize returns the
			### key itself, that key was never defined.
	
			widget = {
				parentanchor = hcenter
				position = { 0 175 }
				size = { 500 30 }

				textbox = {
					visible = "[EqualTo_string(Localize(Concatenate(Event.GetKey, '.sub_left')), Concatenate(Event.GetKey, '.sub_left'))]"
					parentanchor = left|vcenter
					autoresize = yes
					align = nobaseline
					using = fontsize_medium
					default_format = "#news_ink_soft"
					raw_text = "#bold No. 512#!"
				}
				textbox = {
					visible = "[Not(EqualTo_string(Localize(Concatenate(Event.GetKey, '.sub_left')), Concatenate(Event.GetKey, '.sub_left')))]"
					parentanchor = left|vcenter
					autoresize = yes
					align = nobaseline
					using = fontsize_medium
					default_format = "#news_ink_soft"
					text = "#bold [Localize(Concatenate(Event.GetKey, '.sub_left))]"
				}

				textbox = {
					visible = "[EqualTo_string(Localize(Concatenate(Event.GetKey, '.sub_middle')), Concatenate(Event.GetKey, '.sub_middle'))]"
					parentanchor = hcenter|vcenter
					autoresize = yes
					align = hcenter|nobaseline
					using = fontsize_medium
					default_format = "#news_ink_soft"
					raw_text = "#bold [TimeKeeper.GetDayOfWeek], [TimeKeeper.GetCurrentDate.Format('wmw wd, wy')]"
				}
				textbox = {
					visible = "[Not(EqualTo_string(Localize(Concatenate(Event.GetKey, '.sub_middle')), Concatenate(Event.GetKey, '.sub_middle')))]"
					parentanchor = hcenter|vcenter
					autoresize = yes
					align = hcenter|nobaseline
					using = fontsize_medium
					default_format = "#news_ink_soft"
					text = "#bold [Localize(Concatenate(Event.GetKey, '.sub_middle))]"
				}

				textbox = {
					visible = "[EqualTo_string(Localize(Concatenate(Event.GetKey, '.sub_right')), Concatenate(Event.GetKey, '.sub_right'))]"
					parentanchor = right|vcenter
					autoresize = yes
					align = nobaseline
					using = fontsize_medium
					default_format = "#news_ink_soft"
					raw_text = "#bold ONE PENNY#!"
				}
				textbox = {
					visible = "[Not(EqualTo_string(Localize(Concatenate(Event.GetKey, '.sub_right')), Concatenate(Event.GetKey, '.sub_right')))]"
					parentanchor = right|vcenter
					autoresize = yes
					align = nobaseline
					using = fontsize_medium
					default_format = "#news_ink_soft"
					text = "[Localize(Concatenate(Event.GetKey, '.sub_right))]"
				}
			}

			widget = {
				parentanchor = hcenter
				position = { 0 115 }
				size = { 800 25 }
				
				### HEADLINE — the event's own title.
				textbox = {
					name = "headline"
					size = { 540 84 }            
					multiline = yes
					maximumsize = { 550 65 }
					fontsize = 42
					align = hcenter|nobaseline
					fontsize_min = 16
					elide = right
					parentanchor = hcenter
					font = "NewsCheltenhamHeadline"
					default_format = "#news_ink"
					raw_text = "[EventWindow.GetTitle]"
					### SHOUTED HEADLINE (all caps). The capitals are baked into the
					### font glyphs, so the only way to vary them is a second font --
					### hence two textboxes rather than one.
					### Shouts only if this event defines a "<event>.shout" loc key.
					### Read from the event, not from a shared variable, so a second
					### event firing cannot flip this one's font while it is open.
					visible = "[Not(EqualTo_string(Localize(Concatenate(Event.GetKey, '.shout')), Concatenate(Event.GetKey, '.shout')))]"
				}

				textbox = {
					name = "headline_quiet"
					size = { 540 84 }
					multiline = yes
					maximumsize = { 550 65 }
					fontsize = 42
					align = hcenter|nobaseline
					fontsize_min = 16
					elide = right
					parentanchor = hcenter
					font = "NewsCheltenhamHeadlineMixed"
					default_format = "#news_ink"
					raw_text = "[EventWindow.GetTitle]"
					### ORDINARY HEADLINE (mixed case). The default: shown whenever
					### The default: shown whenever the event defines no ".shout" key.
					visible = "[EqualTo_string(Localize(Concatenate(Event.GetKey, '.shout')), Concatenate(Event.GetKey, '.shout'))]"
				}
			}
			
			### THE STORY — right-hand column.
			flowcontainer = {
				direction = vertical
				position = { 275 186 }
				spacing = 8

				widget = { size = { 10 6 } }

				textbox = {
					name = "description"
					multiline = yes
					autoresize = yes
					minimumsize = { 300 -1 }
					maximumsize = { 300 -1 }
					align = nobaseline
					using = fontsize_medium
					font = "NewsCheltenhamBody"
					default_format = "#news_ink"
					raw_text = "[EventWindow.GetDescription]"
				}

				divider_decorative = {}

				textbox = {
					name = "flavortext"
					multiline = yes
					autoresize = yes
					minimumsize = { 300 -1 }
					maximumsize = { 300 -1 }
					align = nobaseline
					using = fontsize_small
					font = "NewsCheltenhamBody"
					default_format = "#news_ink"
					raw_text = "[EventWindow.GetFlavor]"
				}

				widget = { size = { 10 20 } }

				### OPTION BUTTONS — reused verbatim from vanilla, then narrowed
				### to the column. Debug buttons follow these automatically.
										flowcontainer = {
											direction = vertical
											position = { 6 0 }
											datamodel = "[EventWindow.GetOptions]"
											spacing = 5

											item = {
												container = {

													button = {
														visible = "[EventOption.IsDefaultOption]"
														size = { 1 1 }
														alpha = 0
														onclick = "[EventOption.Select]"
														enabled = "[EventOption.IsEnabled]"
														input_action = "confirm"
													}
									
													widget = {
														visible = "[EventOption.IsHighlightedOption]"
										
														button = {
															size = { 96% 100% }
															parentanchor = hcenter
															using = default_button_primary_action
															tooltip = "[EventOption.GetDesc]"
															using = tooltip_ws
															using = confirm_button_sound
															onclick = "[EventOption.Select]"
															enabled = "[EventOption.IsEnabled]"
														}

														textbox = {
															resizeparent = yes
															minimumsize = { 300 40 }
															maximumsize = { 300 -1 }
															multiline = yes
															align = "[GetEventOptionTextAlignment]"
															autoresize = yes
															margin = { 12 8 }
															text = "[EventOption.GetText]"
														}
													}

													widget = {
														visible = "[Not(EventOption.IsHighlightedOption)]"
										
														button = {
															size = { 96% 100% }
															parentanchor = hcenter
															using = default_button_action
															tooltip = "EVENT_OPTION_TOOLTIP"
															using = tooltip_ws
															using = confirm_button_sound
															onclick = "[EventOption.Select]"
															enabled = "[EventOption.IsEnabled]"
														}

														textbox = {
															resizeparent = yes
															minimumsize = { 300 40 }
															maximumsize = { 300 -1 }
															text = "[EventOption.GetText]"
															multiline = yes
															align = "[GetEventOptionTextAlignment]"
															autoresize = yes
															margin = { 12 8 }
															margin_right = 16
														}

														### Time until the default option will be picked
														round_progress_default = {
															visible = "[EventOption.IsDefaultOption]"
															parentanchor = right|vcenter
															position = { -20 0.5 }
															size = { 27 27 }
															tooltip = "DEFAULT_EVENT_OPTION"
															value = "[Event.GetPercentageRemainingDays]"

															icon = {
																size = { 26 26 }
																position = { -0.2 -0.2 }
																parentanchor = center
																texture = "gfx/interface/icons/generic_icons/event_default_option.dds"
															}
														}
													}
												}
											}
										}
			}

			### Close / minimise, top right of the page.
			minimize_button = {
				parentanchor = top|right
				position = { -14 12 }
				onclick = "[PopupManager.HideOpenEvent(Event.Self)]"
				shortcut = "close_window"
			}

			state = {
